# BuildConnect AI Backend Environment Configuration
# Copy this file to .env for backend configuration.
# Never commit real credentials to source control.

DATABASE_URL=postgresql://buildconnect:placeholder_password@localhost:5432/buildconnect
SECRET_KEY=replace-with-at-least-32-random-characters-for-session-signing
JWT_SECRET_KEY=replace-with-at-least-32-random-characters-for-jwt-tokens
ACCESS_TOKEN_EXPIRES_MINUTES=60
REFRESH_TOKEN_EXPIRES_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FLASK_ENV=development
BUILDCONNECT_SECRET_KEY=replace-with-at-least-32-random-characters
BUILDCONNECT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
